# 环境配置
.env

# 密钥（单独 key 文件，gitignore；模板 secrets/dashscope.key.example 可提交）
secrets/*
!secrets/dashscope.key.example

# 百炼 apiKey 下载文件（含真实 Key，放在本机供配置参考，绝不入库）
docs/reference/*apiKey*.csv

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
*.egg-info/
dist/
build/

# 知识库原文（版权保护，不入库，只留建库脚本与脱敏示例）
knowledge/raw/*
!knowledge/raw/.gitkeep

# 运行时数据（SQLite 知识库、管理配置等落盘文件）
data/
*.db
*.sqlite
*.sqlite3

# IDE
.idea/
.vscode/
*.swp
*.swo

# 日志
logs/
*.log

# macOS
.DS_Store

# Windows
Thumbs.db
